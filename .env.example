# Tiendanube — backend
TIENDANUBE_STORE_ID=
TIENDANUBE_ACCESS_TOKEN=
TIENDANUBE_CLIENT_ID=
TIENDANUBE_CLIENT_SECRET=
TIENDANUBE_USER_AGENT="Experiencia Airsoft Store (hola@experienciaairsoft.com)"
TIENDANUBE_WEBHOOK_SECRET=

# Storefront publico nativo de TN (ej: https://experienciaairsoft.mitiendanube.com).
# Usado por /api/cart/checkout para armar el deeplink al checkout hospedado.
TIENDANUBE_STORE_URL=

# Site
NEXT_PUBLIC_SITE_URL=https://tienda.experienciaairsoft.com

# Pedidos del exterior — notificacion por email
# Sin RESEND_API_KEY el endpoint funciona pero loggea en consola en vez de mandar email.
RESEND_API_KEY=
# Email donde caen las notificaciones (default: hola@experienciaairsoft.com)
PEDIDOS_NOTIFICATION_EMAIL=
# From verificado en Resend (ej: "Tienda EA <pedidos@experienciaairsoft.com>")
RESEND_FROM_EMAIL=
